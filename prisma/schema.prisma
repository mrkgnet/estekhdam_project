generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // تغییر از mongodb به postgresql
  url      = env("DATABASE_URL")
}

// ========= ENUMS =========
enum Role {
  user
  admin
  employee
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum NewsStatus {
  OPEN
  CARD_RECEIVED
  RESULTS_ANNOUNCED
  NEWS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  NEW_COMMENT
  NEW_TICKET
  NEW_CONTACT
  NEW_ORDER
  NEW_QPROBLEM
}

enum QuestionType {
  SARASARI
  TALIFI
}

enum CategoryType {
  MAIN // دسته‌بندی‌های اصلی و محصولات پولی
  FREE_RESOURCE // دسته‌بندی منابع رایگان
  BLOG // در آینده می‌توانید مقالات را هم اضافه کنید
}


// تعریف انواع محصول
enum ProductType {
  MAIN          // محصولات پولی و فروشگاهی (پیش‌فرض)
  FREE_RESOURCE // منابع، جزوات و فایل‌های رایگان
}





// ========= MODELS =========

model User {
  id            String         @id @default(uuid()) // تغییر آیدی به uuid
  phoneNumber   String         @unique
  username      String?
  otpCode       String?
  email         String?
  otpExpires    DateTime?
  refreshTokens RefreshToken[]
  firstName     String?
  lastName      String?
  nationalCode  String?
  avatar        String?
  birthDate     DateTime?
  gender        Gender         @default(UNKNOWN)
  role          Role           @default(user)
  isActive      Boolean        @default(true)
  orders           Order[]
  comments         Comment[]
  tickets          Ticket[]               @relation("UserTickets")
  ticketMessages   TicketMessage[]        @relation("UserMessages")
  contacts         Contact[]
  readGlobalNotifs UserNotificationRead[]
  subscriptions UserSubscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalNotification {
  id       String  @id @default(uuid())
  title    String // عنوان اعلان
  message  String // متن اعلان
  isActive Boolean @default(true) // ادمین می‌تواند اعلان را مخفی/غیرفعال کند

  // ارتباط با کاربرانی که این اعلان را خوانده‌اند
  readBy UserNotificationRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotificationRead {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  globalNotificationId String
  globalNotification   GlobalNotification @relation(fields: [globalNotificationId], references: [id], onDelete: Cascade)

  readAt    DateTime @default(now())
  isDeleted Boolean  @default(false)

  // هر کاربر یک اعلان را فقط یکبار ثبت می‌کند
  @@unique([userId, globalNotificationId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GovernmentNews {
  id           String      @id @default(uuid())
  title        String
  slugNews     String      @unique
  organization String
  description  String?
  imageUrl     String?
  registerUrl  String?
  price        Int?
  maxAge       Int?
  startAt      DateTime?
  endAt        DateTime?
  jobs         String[] // پستگرس از آرایه پشتیبانی می‌کند
  cities       String[]
  isActive     Boolean     @default(true)
  isMainSlider Boolean     @default(false)
  status       NewsStatus? @default(NEWS)
  comments     Comment[]
  // رابطه چندبه‌چند استاندارد پستگرس (بدون نیاز به فیلد productIds)
  products     Product[]   @relation("ProductNews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([endAt])
}

model MainSlider {
  id          String   @id @default(uuid())
  imageUrl    String
  title       String?
  description String?
  targetLink  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique  
  // فیلد جدید برای تعیین نوع محصول
  type        ProductType @default(MAIN)
  // 🟢 فیلدهای جدید
  downloadUrl String?     // لینک دانلود (اختیاری)
  downloadCount Int       @default(0) // تعداد دانلود (پیش‌فرض صفر)
// 🟢 فیلد جدید برای تعداد خرید
  purchaseCount Int      @default(0)
  oldPrice    Int?
  newPrice    Int?
  description String?
  imageUrl    String?
  features    String[]
  isActive    Boolean     @default(true) 
  // رابطه چند به چند با دسته‌بندی
  categories  Category[]  @relation("ProductCategories")
  questions   Question[]
  comments    Comment[]
  orders      Order[]
  chapters    Chapter[]
  // رابطه چندبه‌چند با خبر
  governmentNews GovernmentNews[] @relation("ProductNews")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // اضافه کردن ایندکس برای جستجوی سریع‌تر بر اساس نوع محصول
  @@index([type])
}

model Category {
  id        String       @id @default(uuid())
  catName   String       @unique
  catSlug   String       @unique
  imageUrl  String?
  
  // فیلد جدید برای تعیین نوع دسته‌بندی
  type      CategoryType @default(MAIN)

  parentId  String?
  parent    Category?    @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[]   @relation("CategoryToCategory")

  products  Product[]    @relation("ProductCategories") // رابطه با محصول

  createdAt DateTime?    @default(now())
  updatedAt DateTime     @updatedAt

  @@index([parentId])
  @@index([type]) // ایندکس برای جستجوی سریع‌تر بر اساس نوع دسته‌بندی
}

model Chapter {
  id        String     @id @default(uuid())
  title     String
  order     Int?
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryChapter {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id             String       @id @default(uuid())
  questionNumber Int          @default(autoincrement())
  chapterOrder   Int?
  questionText   String
  options        String[]
  correctAnswer  Int
  answerText     String?
  examPoints     String?
  questionType   QuestionType @default(TALIFI)
  questionCode   String?
  isActive       Boolean      @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // ۲. اصلاح رابطه با CategoryChapter (دقت کنید نوع فیلد باید Int باشد تا با CategoryChapter.id همخوان شود)
  categoryChapterId Int?
  categoryChapter   CategoryChapter? @relation(fields: [categoryChapterId], references: [id], onDelete: SetNull)

  issues    QuestionIssue[]
  comments  Comment[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([categoryChapterId])
  @@index([productId])
  @@index([chapterId])
  @@index([questionType])
}

model QuestionIssue {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  description String
  isRead      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model Comment {
  id          String  @id @default(uuid())
  textComment String
  status      String  @default("APPROVED")
  isRead      Boolean @default(false)
  section     String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // ===== کدهای جدید برای ارتباط با اخبار =====
  governmentNewsId String?
  governmentNews   GovernmentNews? @relation(fields: [governmentNewsId], references: [id])
  // ===========================================

  // ===== کدهای جدید برای ارتباط با سوالات =====
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id])
  // ===========================================

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

model MenuClient {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String  @unique
  imageUrl  String?
  customUrl String?
  order     Int     @default(0)

  parentId String?
  parent   MenuClient?  @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children MenuClient[] @relation("MenuToMenu")

  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt
}

model Order {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 🟢 خرید محصول (اختیاری)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // 🟢 خرید پلن اشتراک (اختیاری)
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  // 🟢 رابطه با اشتراک ایجاد شده
  subscription UserSubscription?

  pricePaid Int
  status    OrderStatus @default(PENDING)

  refId     String? @unique
  authority String? @unique

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([subscriptionPlanId])
}

model Ticket {
  id       String         @id @default(uuid())
  subject  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  userId String?
  user   User?   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMessage {
  id   String @id @default(uuid())
  text String

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Contact {
  id      String  @id @default(uuid())
  title   String
  message String
  isRead  Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  message     String
  referenceId String
  isRead      Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
}

model TopBanner {
  id        String  @id @default(uuid())
  title     String // متن بنر
  imageUrl  String // لینک عکس بنر
  targetUrl String // لینک مقصد
  slug      String  @unique // اسلاگ بنر
  isActive  Boolean @default(true) // فعال یا غیرفعال

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}




// ==========================================
// 🟢 مدل‌های جدید برای سیستم پلن اشتراک
// ==========================================

model SubscriptionPlan {
  id            String   @id @default(uuid())
  title         String   // عنوان پلن (مثلاً: اشتراک سه ماهه)
  slug          String   @unique
  durationDays  Int      // مدت زمان به روز (مثلاً 30, 90, 180)
  price         Int      // قیمت اصلی (تومان)
  discountPrice Int?     // قیمت با تخفیف (اختیاری)
  description   String?
  features      String[]
  isPopular     Boolean  @default(false)
  isActive      Boolean  @default(true)

  subscriptions UserSubscription[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model UserSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([endDate])
}